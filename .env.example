# Copie para .env privado. Uvicorn carrega com --env-file .env.
# Nunca aponte testes para bancos ativos. Use PostgreSQL exclusivo.
POSTGRES_PASSWORD=troque-por-uma-senha-local
DATABASE_URL=postgresql+psycopg://lumi:troque-por-uma-senha-local@127.0.0.1:55439/lumi_v3_dev
LUMI_DATA_DIR=.data/local
LOCALAPPDATA=.data/local
LUMI_TOOLS_ENV=.data/local/tools.env
RINCAO_COMMERCE_DATA_DIR=.data/local/commerce
# false preserva o backup sem criar contas e conteúdo de demonstração.
LUMI_SEED_DEMO=false
# true exige login e tenant autorizado no simulador publicado.
LUMI_PRIVATE_SIMULATOR=false

# Provider, modelo e chave OpenAI são configurados POR TENANT no painel Brevia.
# Chave Fernet de criptografia do servidor, não é uma chave OpenAI. Gere privadamente.
LUMI_AI_SECRET_KEY=
# Infraestrutura compartilhada apenas para tenants que escolhem codex_gateway.
LUMI_CODEX_GATEWAY_URL=
LUMI_CODEX_GATEWAY_TOKEN=
