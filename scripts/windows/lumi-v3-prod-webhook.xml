<service>
  <id>lumi-v3-prod-webhook</id>
  <name>Lumi V3 Producao WhatsApp</name>
  <description>Receptor assinado e entrega WhatsApp da Lumi V3 em producao.</description>
  <executable>C:\LumiV3-PROD\venv\Scripts\python.exe</executable>
  <arguments>-m uvicorn app.whatsapp.webhook:app --host 127.0.0.1 --port 8015 --workers 1 --env-file C:\LumiV3-PROD\private\prod.env --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log --timeout-graceful-shutdown 130</arguments>
  <workingdirectory>C:\LumiV3-PROD\current</workingdirectory>
  <env name="LOCALAPPDATA" value="C:\LumiV3-PROD\data" />
  <env name="PYTHONUTF8" value="1" />
  <env name="PYTHONUNBUFFERED" value="1" />
  <env name="PYTHONDONTWRITEBYTECODE" value="1" />
  <startmode>Automatic</startmode>
  <depend>lumi-postgresql-16-prod</depend>
  <serviceaccount><domain>NT AUTHORITY</domain><user>LocalService</user></serviceaccount>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <stoptimeout>140 sec</stoptimeout>
  <logpath>C:\LumiV3-PROD\logs</logpath>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>5</keepFiles></log>
</service>
